# Copy this file to backend/.env and change what you need. Never commit backend/.env.
# Every setting is optional; the defaults are in app/config.py.

# mock = synthetic data, no network (default). live = real SPHEREx data.
SM_MODE=mock

# Collections to search, comma separated. A new data release is one more name here.
# SM_COLLECTIONS=spherex_dr1,spherex_qr3,spherex_dr1_deep,spherex_qr3_deep

# Most exposures returned by one request.
# SM_MAX_EXPOSURES=300

# Web addresses allowed to call the API from a browser, comma separated.
# SM_CORS_ORIGINS=http://localhost:5173
